<mujoco model="fr3_desk_pick">
  <include file="fr3_robot_included.xml"/>

  <statistic center="0.45 0 0.42" extent="1.0"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="120" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
    <material name="wood" rgba="0.72 0.58 0.42 1"/>
    <material name="place_mat" rgba="0.15 0.75 0.25 0.35"/>
  </asset>

  <worldbody>
    <light pos="0 0 1.6" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>

    <body name="desk" pos="0.62 0 0.38">
      <geom name="desk_top" type="box" size="0.42 0.32 0.02" material="wood" friction="1 0.02 0.002"/>
    </body>

    <!-- mocap 方块：由脚本同步到末端，实现无夹爪「抓取」演示；nq 仍为 7 -->
    <body name="pick_block" mocap="true" pos="0.55 0.12 0.425">
      <geom name="pick_geom" type="box" size="0.02 0.02 0.02" rgba="0.95 0.25 0.2 1" contype="0" conaffinity="0"/>
    </body>

    <body name="place_zone" pos="0.38 -0.2 0.425">
      <geom name="place_pad" type="box" size="0.1 0.1 0.003" contype="0" conaffinity="0" group="2" material="place_mat"/>
    </body>
  </worldbody>

  <keyframe>
    <key name="desk_home"
      qpos="0 0 0 -1.57079 0 1.57079 -0.7853"
      ctrl="0 0 0 -1.57079 0 1.57079 -0.7853"/>
  </keyframe>
</mujoco>
